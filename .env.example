# Copy to .env (gitignored). Read by docker compose for the `standard` and `docparse` profiles.

# Governance DB (`standard`, `docparse`). Either the bundled PostgreSQL + pgvector (`--profile db`):
STEWARD_DB_PASSWORD=          # openssl rand -hex 16
# or your own, as seen from inside a container (leave unset to use the bundled one), e.g.
# STEWARD_STANDARD_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@host.docker.internal:5432/llm_steward

# Memory engine for `standard` / `docparse` (switching an existing deployment: `steward resync`):
#   litemem  (default) lite-mem (https://github.com/ArthurGao/lite-mem) in-process: extracts and
#            resolves conflicts itself; embeddings bge-m3:567m on the host's Ollama (WeKnora's model)
#   mem0     mem0 2.2.1 in-process: extracts; llm-steward compensates conflicts (needs the LLM below)
#   native   llm-steward extracts the facts itself: also set STEWARD_MEMORY_LLM=true
STEWARD_MEMORY_PROVIDER=litemem
STEWARD_MEMORY_LLM=false
# Or lite-mem as a service of its own: a key whose namespaces cover steward/*
# (litemem key new steward -n 'steward/*'), its URL as seen from the container.
# STEWARD_LITEMEM_MODE=http
# STEWARD_LITEMEM_URL=http://host.docker.internal:8710
# STEWARD_LITEMEM_API_KEY=

# LLM for memory extraction inside the container: lite-mem's (unset: qwen3:8b on the host's
# Ollama) and mem0's conflict compensation (required with mem0). A vendor endpoint or the host's
# Ollama: llm-gateway listens on the host's loopback only and cannot serve containers.
STEWARD_LLM_BASE_URL=
STEWARD_LLM_API_KEY=
STEWARD_LLM_MODEL=

# WeKnora secrets. Generate once and keep: losing SYSTEM_AES_KEY makes WeKnora's encrypted fields unreadable.
WEKNORA_DB_PASSWORD=          # openssl rand -hex 16
WEKNORA_REDIS_PASSWORD=       # openssl rand -hex 16
WEKNORA_JWT_SECRET=           # openssl rand -hex 32
WEKNORA_SYSTEM_AES_KEY=       # openssl rand -hex 16  (exactly 32 ASCII characters)
# WeKnora has no default account: deploy/weknora/bootstrap.py registers this owner.
WEKNORA_ADMIN_EMAIL=steward-admin@example.test
WEKNORA_ADMIN_PASSWORD=       # 8-32 characters, letters and digits
# What deploy/weknora/bootstrap.py prints, for the `standard` container (STEWARD_WEKNORA_URL is set
# by compose: the container reaches WeKnora on its network).
STEWARD_WEKNORA_API_KEY=
STEWARD_WEKNORA_EMBEDDING_MODEL_ID=

# RAGFlow (`docparse`; its own stack, deploy/ragflow/README.md). deploy/ragflow/bootstrap.py registers
# this account and prints STEWARD_RAGFLOW_API_KEY for the `docparse` container.
RAGFLOW_ADMIN_EMAIL=steward-admin@example.test
RAGFLOW_ADMIN_PASSWORD=       # openssl rand -hex 16
STEWARD_RAGFLOW_API_KEY=
