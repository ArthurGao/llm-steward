# Copy to .env (gitignored). Read by docker compose for the `standard` and `docparse` profiles.

# Governance DB as seen from inside a container (the shared local PG, database llm_steward).
STEWARD_STANDARD_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@host.docker.internal:5432/llm_steward

# LLM for mem0 extraction and conflict compensation inside the `standard` container (a vendor
# endpoint: llm-gateway listens on the host's loopback only and cannot serve containers).
STEWARD_LLM_BASE_URL=
STEWARD_LLM_API_KEY=
STEWARD_LLM_MODEL=

# WeKnora secrets. Generate once and keep: losing SYSTEM_AES_KEY makes WeKnora's encrypted fields unreadable.
WEKNORA_DB_PASSWORD=          # openssl rand -hex 16
WEKNORA_REDIS_PASSWORD=       # openssl rand -hex 16
WEKNORA_JWT_SECRET=           # openssl rand -hex 32
WEKNORA_SYSTEM_AES_KEY=       # openssl rand -hex 16  (exactly 32 ASCII characters)
# WeKnora has no default account: deploy/weknora/bootstrap.py registers this owner.
WEKNORA_ADMIN_EMAIL=steward-admin@example.test
WEKNORA_ADMIN_PASSWORD=       # 8-32 characters, letters and digits
# What deploy/weknora/bootstrap.py prints, for the `standard` container (STEWARD_WEKNORA_URL is set
# by compose: the container reaches WeKnora on its network).
STEWARD_WEKNORA_API_KEY=
STEWARD_WEKNORA_EMBEDDING_MODEL_ID=

# RAGFlow (`docparse`; its own stack, deploy/ragflow/README.md). deploy/ragflow/bootstrap.py registers
# this account and prints STEWARD_RAGFLOW_API_KEY for the `docparse` container.
RAGFLOW_ADMIN_EMAIL=steward-admin@example.test
RAGFLOW_ADMIN_PASSWORD=       # openssl rand -hex 16
STEWARD_RAGFLOW_API_KEY=
