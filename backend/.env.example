# Copy to backend/.env (gitignored). Read when running `uv run ...` from backend/.

# Governance store. Local PG: shared container postgresql-postgres-1, database llm_steward.
# For the native profile use: sqlite+aiosqlite:///./data/steward.db
STEWARD_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@localhost:5432/llm_steward
# Tests: PostgreSQL cases fail (not skip) without it; the database name must end with _test.
STEWARD_TEST_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@localhost:5432/llm_steward_test

STEWARD_MEMORY_PROVIDER=native   # mem0 | native
STEWARD_KB_PROVIDER=native       # weknora | ragflow | native
STEWARD_WEKNORA_URL=http://localhost:8680
STEWARD_WEKNORA_API_KEY=
STEWARD_LLM_MODEL=anthropic/claude-haiku-5-5
