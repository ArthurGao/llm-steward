# Copy to backend/.env (gitignored). Read when running `uv run ...` from backend/.

# Governance store. Local PG: shared container postgresql-postgres-1, database llm_steward.
# For the native profile use: sqlite+aiosqlite:///./data/steward.db
STEWARD_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@localhost:5432/llm_steward
# Tests: set explicitly (never inherited from the app URL). Locally the same database; tests
# work only in schema `steward_test`. PG cases fail, never skip, without it.
STEWARD_TEST_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@localhost:5432/llm_steward

STEWARD_MEMORY_PROVIDER=native   # mem0 | native | litemem
STEWARD_KB_PROVIDER=native       # weknora | ragflow | native | literag
STEWARD_WEKNORA_URL=http://localhost:8680
STEWARD_WEKNORA_API_KEY=          # printed by deploy/weknora/bootstrap.py
STEWARD_WEKNORA_EMBEDDING_MODEL_ID=  # printed by deploy/weknora/bootstrap.py
STEWARD_RAGFLOW_URL=http://127.0.0.1:8690
STEWARD_RAGFLOW_API_KEY=          # printed by deploy/ragflow/bootstrap.py
STEWARD_KB_MAX_UPLOAD_MB=20      # KB document uploads (WeKnora accepts up to 50)
# Optional rerank (uv sync --extra rerank): e.g. BAAI/bge-reranker-v2-m3-int8 (0.57 GB, downloaded once)
STEWARD_RERANK_MODEL=
STEWARD_RERANK_TIMEOUT_MS=3000
# User tokens for browsers (POST /v1/tokens/user): at least 32 bytes, e.g. `openssl rand -hex 32`.
# Unset (commented out): no user token is issued or accepted.
# STEWARD_TOKEN_SECRET=
# The Admin API (/admin/v1): a static token, at least 32 bytes (e.g. `openssl rand -hex 32`); no login,
# no accounts. Unset (commented out): the Admin API is off.
# STEWARD_ADMIN_TOKEN=
# Browser origins that may call the API (e.g. the Admin run locally): JSON list. Empty: same origin.
# STEWARD_CORS_ORIGINS=["http://127.0.0.1:8610"]
# Requests per minute per API key, in this process (a namespace may set its own).
STEWARD_RATE_LIMIT_PER_MINUTE=600
# Webhooks and document URLs reach public https addresses only. Local development only: true also
# allows private addresses and plain http (e.g. a webhook receiver on localhost).
STEWARD_ALLOW_PRIVATE_URLS=false
# A webhook's secret lives in the variable its namespace config names, e.g.:
# STEWARD_WEBHOOK_SECRET_ACME=
# lite-rag (STEWARD_KB_PROVIDER=literag): its HTTP service by default; a lite-rag key whose
# namespaces cover steward/* (literag key create). inprocess needs `uv sync --extra literag`.
STEWARD_LITERAG_MODE=http        # http | inprocess
STEWARD_LITERAG_URL=http://127.0.0.1:8700
STEWARD_LITERAG_API_KEY=
# STEWARD_LITERAG_SEARCH_MODE=hybrid   # vector | bm25 | graph | hybrid; graph needs lite-rag's graph.enabled
# lite-mem (STEWARD_MEMORY_PROVIDER=litemem): its HTTP service by default; a lite-mem key whose
# namespaces cover steward/* (litemem key new steward -n 'steward/*'). inprocess needs
# `uv sync --extra litemem` and lite-mem's own LITEMEM_* settings (or STEWARD_LITEMEM_CONFIG).
STEWARD_LITEMEM_MODE=http        # http | inprocess
STEWARD_LITEMEM_URL=http://127.0.0.1:8710
STEWARD_LITEMEM_API_KEY=

# LLM role layer (memory.extract for mem0, memory.resolve for conflict compensation, kb.* with
# STEWARD_KB_LLM), through lite-model: a backend (gateway, openai, ollama, litellm, or one of your
# own in STEWARD_LLM__BACKENDS) and a model; per role in STEWARD_LLM__ROLES. Unset: no LLM roles.
# Local dev through llm-gateway (start it first: curl -s http://127.0.0.1:8787/healthz):
STEWARD_LLM__BACKEND=gateway
STEWARD_LLM__MODEL=gpt-sub
# STEWARD_LLM__ROLES={"memory.resolve": {"model": "claude-sub"}}   # per-role override (JSON)
# A vendor: STEWARD_LLM__BACKEND=openai, STEWARD_LLM__MODEL=gpt-4.1-mini, OPENAI_API_KEY=...
# Another OpenAI-compatible endpoint:
# STEWARD_LLM__BACKENDS={"vendor": {"type": "openai", "base_url": "https://…/v1", "api_key_env": "VENDOR_KEY"}}

# Episode buffer and drift check.
STEWARD_BUFFER_TOKENS=1024
STEWARD_BUFFER_IDLE_MINUTES=30
STEWARD_RECONCILE_INTERVAL_HOURS=24
STEWARD_DATA_DIR=./data

# Native provider: local embedding model (downloads once, then offline) and where it is cached.
STEWARD_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
STEWARD_MODEL_CACHE_DIR=./data/models
# Run the outbox worker inside `steward serve` (single process). Set false and run `steward worker`.
STEWARD_RUN_WORKER=true
# A database that scales to zero (e.g. Neon): the worker stops querying this many seconds after the last
# request or job, waking on a request, the next due job, or the episode buffers' idle flush. Unset: polls every second.
# Only when this API process is the one that enqueues jobs: another process's job waits for the next request.
# STEWARD_WORKER_IDLE_AFTER_S=120
