# Copy to backend/.env (gitignored). Read when running `uv run ...` from backend/.

# Governance store. Local PG: shared container postgresql-postgres-1, database llm_steward.
# For the native profile use: sqlite+aiosqlite:///./data/steward.db
STEWARD_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@localhost:5432/llm_steward
# Tests: set explicitly (never inherited from the app URL). Locally the same database; tests
# work only in schema `steward_test`. PG cases fail, never skip, without it.
STEWARD_TEST_DATABASE_URL=postgresql+asyncpg://llm_steward:CHANGE_ME@localhost:5432/llm_steward

STEWARD_MEMORY_PROVIDER=native   # mem0 | native
STEWARD_KB_PROVIDER=native       # weknora | ragflow | native | literag
STEWARD_WEKNORA_URL=http://localhost:8680
STEWARD_WEKNORA_API_KEY=          # printed by deploy/weknora/bootstrap.py
STEWARD_WEKNORA_EMBEDDING_MODEL_ID=  # printed by deploy/weknora/bootstrap.py
STEWARD_KB_MAX_UPLOAD_MB=20      # KB document uploads (WeKnora accepts up to 50)
# lite-rag (STEWARD_KB_PROVIDER=literag): its HTTP service by default; a lite-rag key whose
# namespaces cover steward/* (literag key create). inprocess needs `uv sync --extra literag`.
STEWARD_LITERAG_MODE=http        # http | inprocess
STEWARD_LITERAG_URL=http://127.0.0.1:8700
STEWARD_LITERAG_API_KEY=
STEWARD_LLM_MODEL=anthropic/claude-haiku-5-5

# LLM role layer (memory.extract for mem0, memory.resolve for conflict compensation).
# Local dev through llm-gateway (start it first: curl -s http://127.0.0.1:8787/healthz):
STEWARD_LLM_BASE_URL=http://127.0.0.1:8787/v1
STEWARD_LLM_API_KEY=llmgw-local
STEWARD_LLM_MODEL=gpt-sub
# STEWARD_LLM_ROLES={"memory.resolve":"claude-sub"}   # per-role override (JSON)

# Episode buffer and drift check.
STEWARD_BUFFER_TOKENS=1024
STEWARD_BUFFER_IDLE_MINUTES=30
STEWARD_RECONCILE_INTERVAL_HOURS=24
STEWARD_DATA_DIR=./data

# Native provider: local embedding model (downloads once, then offline) and where it is cached.
STEWARD_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
STEWARD_MODEL_CACHE_DIR=./data/models
# Run the outbox worker inside `steward serve` (single process). Set false and run `steward worker`.
STEWARD_RUN_WORKER=true
