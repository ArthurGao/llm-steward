{# Prompt context for format=context (design §6). Every item carries a citation id so the model can
   cite it and feedback can find it; unverified knowledge is marked as such. Labels (`t`) come in the
   query's language (retrieval_service._LABELS). A document's further
   passages are indented under its line. #}
{% if memories %}
## {{ t.user }}
{% for m in memories %}
- [mem:{{ m.id }}] {{ m.content }}
{% endfor %}
{% endif %}
{% if memories and kb %}

{% endif %}
{% if kb %}
## {{ t.kb }}
{% for k in kb %}
- [kb:{{ k.id }}] {{ k.title }}{{ t.sep }}{{ k.passages[0] if k.passages else k.content }}{{ t.yes if k.verified else t.no }}
{% for p in k.passages[1:] %}
  - {{ p }}
{% endfor %}
{% endfor %}
{% endif %}
