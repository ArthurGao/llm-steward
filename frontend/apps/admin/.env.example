# Copy to .env.local. Neither value is a secret: the admin token is typed into the Connect page.
# mock (default): the in-browser demo, no backend. live: connect to a real llm-steward backend.
VITE_API_MODE=mock
# Pre-filled on the Connect page in live mode. The backend must list the Admin's origin in
# STEWARD_CORS_ORIGINS when the two are on different origins.
VITE_API_BASE_URL=http://127.0.0.1:8600
